SCHIPHOL_APP_ID=
SCHIPHOL_APP_KEY=
# Client token for the native iOS app's Schiphol board calls. Not a Schiphol key.
# Same value lives in GearUp-iOS APIConfig.boardToken. Set on Netlify env too.
GEARUP_IOS_BOARD_TOKEN=
# Official Flightradar24 API token. Server / Netlify only. Never ship to iOS or the browser.
FR24_API_KEY=
